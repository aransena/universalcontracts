{
  "schema": "universal.workflow.queue.v1",
  "id": "example_billing_events",
  "kind": "event_surface",
  "created_at": "2026-06-05T12:00:00Z",
  "producer": {
    "project": "example-billing-service",
    "version": "0.1.0"
  },
  "contracts": [
    "universal.workflow.queue.v1",
    "universal.api.webhook.v1",
    "universal.core.stream.v1",
    "universal.core.observability.v1",
    "universal.core.permissions.v1"
  ],
  "profile": "universal.profile.event_producer_consumer.v1",
  "transport": {
    "kind": "queue",
    "delivery": "at_least_once"
  },
  "messages": {
    "invoice_paid": {
      "schema": "example.invoice_paid.v1",
      "key": "invoice_id",
      "timestamps": ["timestamp_unix_ns"]
    }
  },
  "delivery": {
    "ordering": "per_key",
    "dedupe": "message_id",
    "dead_letter": "billing_events_dead_letter"
  },
  "observability": {
    "metrics": ["lag", "failures"],
    "logs": ["consumer_errors"]
  }
}
