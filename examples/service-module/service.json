    "kind": "service_token"
  },
  "endpoints": {
    "get_account": {
      "method": "GET",
      "path": "/accounts/{account_id}"
    }
  },
  "runtime": {
    "process": "web"
  },
  "observability": {
    "health": "/health",
    "metrics": "/metrics"
  }
