{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-contracts.dev/schemas/lifecycle.v1.schema.json",
  "title": "Universal Lifecycle v1",
  "type": "object",
  "required": ["schema", "state", "closed_cleanly"],
  "properties": {
    "schema": { "const": "universal.core.lifecycle.v1" },
    "state": {
      "enum": [
        "created",
        "prepared",
        "running",
        "pausing",
        "paused",
        "closing",
        "closed",
        "cancelled",
        "failed"
      ]
    },
    "created_unix_ns": { "type": ["integer", "null"] },
    "prepared_unix_ns": { "type": ["integer", "null"] },
    "started_unix_ns": { "type": ["integer", "null"] },
    "ended_unix_ns": { "type": ["integer", "null"] },
    "closed_cleanly": { "type": ["boolean", "null"] },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

