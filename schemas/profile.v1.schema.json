{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-contracts.dev/schemas/profile.v1.schema.json",
  "title": "Universal Contract Profile v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "title",
    "maturity",
    "base_contracts",
    "required_fields",
    "integration_points",
    "conformance"
  ],
  "properties": {
    "schema": { "const": "universal.profile.v1" },
    "id": {
      "type": "string",
      "pattern": "^universal\\.profile\\.[a-z0-9_]+\\.v[0-9]+$"
    },
    "kind": { "const": "profile" },
    "title": { "type": "string" },
    "profile_type": { "type": "string" },
    "summary": { "type": "string" },
    "maturity": { "enum": ["draft", "candidate", "stable", "deprecated"] },
    "candidate_since": { "type": "string" },
    "base_contracts": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "domain_packs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "required_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "allowed_values": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "schemas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "integration_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "contracts", "required"],
        "properties": {
          "name": { "type": "string" },
          "contracts": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "conformance": {
      "type": "object",
      "required": ["minimum_level", "levels", "checks"],
      "properties": {
        "minimum_level": { "type": "string" },
        "levels": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "agent_guidance": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
